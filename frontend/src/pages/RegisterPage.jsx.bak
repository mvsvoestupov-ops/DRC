import React, { useState } from 'react';
import { Form, Input, Button, message, Typography, Checkbox, Row, Col, Divider } from 'antd';
import { useNavigate } from 'react-router-dom';
import axios from 'axios';

const { Title, Paragraph, Text } = Typography;

const RegisterPage = () => {
  const [form] = Form.useForm();
  const [loading, setLoading] = useState(false);
  const navigate = useNavigate();

  const onFinish = async (values) => {
    setLoading(true);
    try {
      // Отправка данных на бэкенд
      await axios.post('/api/register', {
        fullName: values.fullName,
        email: values.email,
        phone: values.phone,
        organization: values.organization,
        position: values.position,
      });
      message.success('Спасибо! Ваша заявка принята. Мы свяжемся с вами для подтверждения.');
      form.resetFields();
    } catch (error) {
      message.error('Ошибка регистрации. Попробуйте позже.');
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{
      fontFamily: "'Inter', sans-serif",
      backgroundColor: '#f5f7fc',
      padding: '24px',
      minHeight: '100vh',
      display: 'flex',
      justifyContent: 'center',
      alignItems: 'center',
    }}>
      <div style={{
        maxWidth: '1200px',
        width: '100%',
        background: '#ffffff',
        borderRadius: '40px',
        boxShadow: '0 20px 60px rgba(0, 20, 50, 0.08)',
        overflow: 'hidden',
        position: 'relative',
      }}>
        {/* Кнопка "Войти" */}
        <div style={{
          position: 'absolute',
          top: 24,
          right: 32,
          zIndex: 10,
        }}>
          <Button
            type="primary"
            ghost
            onClick={() => navigate('/login')}
            style={{ 
              borderRadius: 20, 
              borderColor: '#ffffff', 
              color: '#ffffff',
              fontWeight: 500,
              padding: '0 24px',
              height: 40,
              background: 'rgba(255,255,255,0.1)',
              backdropFilter: 'blur(4px)',
            }}
          >
            Войти
          </Button>
        </div>

        {/* Hero-блок */}
        <div style={{
          background: 'linear-gradient(145deg, #0b1a33 0%, #1d3b66 100%)',
          padding: '48px 56px 40px',
          color: '#fff',
          position: 'relative',
          overflow: 'hidden',
        }}>
          <div style={{
            position: 'absolute',
            right: '-40px',
            top: '-40px',
            width: '320px',
            height: '320px',
            background: 'rgba(255, 255, 255, 0.02)',
            borderRadius: '50%',
            pointerEvents: 'none',
          }} />
          <div style={{
            display: 'inline-block',
            background: 'rgba(255, 255, 255, 0.12)',
            backdropFilter: 'blur(4px)',
            padding: '6px 18px',
            borderRadius: '40px',
            fontSize: '13px',
            fontWeight: 600,
            letterSpacing: '0.3px',
            textTransform: 'uppercase',
            color: '#b6d0f0',
            marginBottom: '20px',
            border: '1px solid rgba(255, 255, 255, 0.06)',
          }}>
            <i className="fas fa-calendar-alt" style={{ marginRight: '6px' }}></i> 30 июня 2026
          </div>
          <h1 style={{
            fontSize: '42px',
            fontWeight: 700,
            letterSpacing: '-0.02em',
            lineHeight: 1.2,
            maxWidth: '800px',
            marginBottom: '12px',
          }}>
            Стратегическая сессия<br />
            <span style={{ color: '#8bb9ff' }}>«Цифровой реестр компетенций – жизненный цикл»</span>
          </h1>
          <p style={{
            fontSize: '18px',
            color: '#c9dbf5',
            maxWidth: '640px',
            marginBottom: '28px',
            fontWeight: 400,
          }}>
            Цифровая трансформация системы оценки качества образования. 
            Создание Цифрового реестра компетенций с учётом запросов рынка труда, 
            сетевого международного сотрудничества и экспорта российского образования.
          </p>
          <div style={{
            display: 'flex',
            flexWrap: 'wrap',
            gap: '28px 48px',
            fontSize: '15px',
            color: '#d6e4fa',
            borderTop: '1px solid rgba(255, 255, 255, 0.08)',
            paddingTop: '24px',
            marginTop: '8px',
          }}>
            <span><i className="fas fa-map-pin" style={{ marginRight: 8, color: '#8bb9ff' }}></i> Москва, Ленинградский пр-т, 49/2</span>
            <span><i className="fas fa-building" style={{ marginRight: 8, color: '#8bb9ff' }}></i> Финансовый университет</span>
            <span><i className="fas fa-clock" style={{ marginRight: 8, color: '#8bb9ff' }}></i> 15:30 (очный формат)</span>
            <span><i className="fas fa-users" style={{ marginRight: 8, color: '#8bb9ff' }}></i> Для руководителей и экспертов</span>
          </div>
        </div>

        {/* Контент */}
        <div style={{ padding: '48px 56px 56px' }}>
          <Row gutter={[40, 40]}>
            <Col xs={24} md={12}>
              <Title level={4} style={{ marginBottom: 8 }}>Организаторы</Title>
              <Paragraph>
                <strong>АО «Национальные квалификации» (АО «НК»)</strong> при поддержке 
                Национального совета при Президенте РФ по профессиональным квалификациям, 
                Рособрнадзора и ФГБУ «Росаккредагентство». На площадке Финансового университета.
              </Paragraph>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: '12px', marginTop: 8 }}>
                <a href="https://ao-nk.ru/" target="_blank" rel="noopener noreferrer" style={{ color: '#1d3b66', fontWeight: 500 }}>АО «НК»</a>
                <a href="https://nspkrf.ru/" target="_blank" rel="noopener noreferrer" style={{ color: '#1d3b66', fontWeight: 500 }}>Национальный совет</a>
                <a href="https://obrnadzor.gov.ru/" target="_blank" rel="noopener noreferrer" style={{ color: '#1d3b66', fontWeight: 500 }}>Рособрнадзор</a>
                <a href="https://www.nica.ru/" target="_blank" rel="noopener noreferrer" style={{ color: '#1d3b66', fontWeight: 500 }}>Росаккредагентство</a>
                <a href="https://www.fa.ru/" target="_blank" rel="noopener noreferrer" style={{ color: '#1d3b66', fontWeight: 500 }}>Финансовый университет</a>
              </div>
            </Col>
            <Col xs={24} md={12}>
              <Title level={4} style={{ marginBottom: 8 }}>Цель сессии</Title>
              <Paragraph>
                Проанализировать жизненный цикл формирования профессиональных компетенций как совокупного результата обучения по запросу работодателя. Обсуждение с участием представителей Национального совета, Рособрнадзора, Росаккредагентства, ФУМО и отраслевых ФОИВов.
              </Paragraph>
            </Col>
          </Row>

          <Divider style={{ margin: '32px 0' }} />

          <Title level={4} style={{ marginBottom: 16 }}>Программа сессии</Title>
          <div style={{ background: '#f8faff', borderRadius: '24px', padding: '20px 28px', border: '1px solid #eef3fc' }}>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>09:30 – 10:00</span>
                <span>Сбор, регистрация, кофе</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>10:00 – 10:15</span>
                <span>Открытие и приветствие</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>10:15 – 11:00</span>
                <span>Обзорная лекция «Цифровой реестр компетенций: результаты первой сессии и ключевые вызовы»</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>11:00 – 11:15</span>
                <span>Инструктаж по работам в группах</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>11:15 – 13:00</span>
                <span>Групповая работа. Блок 1 – Разработка компетенции</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>13:00 – 14:00</span>
                <span>Обед</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>14:00 – 15:15</span>
                <span>Групповая работа. Блок 2 – Валидация и экспертиза</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>15:15 – 15:30</span>
                <span>Кофе-пауза</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px solid #eef3fc' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>15:30 – 16:45</span>
                <span>Деловая игра – защита компетенции перед руководством</span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0' }}>
                <span style={{ fontWeight: 600, color: '#1d3b66' }}>16:45 – 17:15</span>
                <span>Подведение итогов, принятие решений. Анонс и приглашение на 3 сессию</span>
              </div>
            </div>
          </div>

          <Divider style={{ margin: '32px 0' }} />

          {/* Форма регистрации */}
          <div style={{
            background: '#f8faff',
            borderRadius: '32px',
            padding: '40px 44px',
            border: '1px solid #eef3fc',
          }}>
            <Title level={4} style={{ marginBottom: 4 }}>Регистрация на сессию</Title>
            <Paragraph type="secondary" style={{ marginBottom: 24 }}>
              Заполните форму, чтобы подтвердить участие в мероприятии. Регистрация открыта до 28 июня 2026 года.
            </Paragraph>

            <Form form={form} layout="vertical" onFinish={onFinish} requiredMark={false}>
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px 28px' }}>
                <div style={{ gridColumn: '1 / -1' }}>
                  <Form.Item
                    name="fullName"
                    label={<><span style={{ color: '#c72a2a' }}>*</span> ФИО</>}
                    rules={[{ required: true, message: 'Введите ФИО' }]}
                  >
                    <Input placeholder="Иванов Иван Иванович" size="large" />
                  </Form.Item>
                </div>
                <Form.Item
                  name="email"
                  label={<><span style={{ color: '#c72a2a' }}>*</span> E-mail</>}
                  rules={[{ required: true, type: 'email', message: 'Введите корректный email' }]}
                >
                  <Input placeholder="ivanov@example.ru" size="large" />
                </Form.Item>
                <Form.Item
                  name="phone"
                  label={<><span style={{ color: '#c72a2a' }}>*</span> Телефон</>}
                  rules={[{ required: true, message: 'Введите телефон' }]}
                >
                  <Input placeholder="+7 (999) 123-45-67" size="large" />
                </Form.Item>
                <Form.Item
                  name="organization"
                  label={<><span style={{ color: '#c72a2a' }}>*</span> Организация</>}
                  rules={[{ required: true, message: 'Введите организацию' }]}
                >
                  <Input placeholder="Название компании / вуза" size="large" />
                </Form.Item>
                <Form.Item
                  name="position"
                  label={<><span style={{ color: '#c72a2a' }}>*</span> Должность</>}
                  rules={[{ required: true, message: 'Введите должность' }]}
                >
                  <Input placeholder="Руководитель, эксперт ..." size="large" />
                </Form.Item>
              </div>

              <Form.Item
                name="agree"
                valuePropName="checked"
                rules={[{ validator: (_, value) => value ? Promise.resolve() : Promise.reject('Необходимо согласие') }]}
                style={{ marginTop: '8px' }}
              >
                <Checkbox>
                  Я согласен(на) на обработку персональных данных и подтверждаю, 
                  что ознакомлен(а) с <a href="https://ao-nk.ru/upload/a60/Politika-v-oblasti-obrabotki-i-zashhity-PDn-27082025.pdf" target="_blank" rel="noopener noreferrer" style={{ color: '#1d3b66', textDecoration: 'underline' }}>политикой конфиденциальности</a>.
                  <span style={{ color: '#c72a2a' }}> *</span>
                </Checkbox>
              </Form.Item>

              <Button
                type="primary"
                htmlType="submit"
                loading={loading}
                size="large"
                style={{
                  background: '#0b1a33',
                  border: 'none',
                  borderRadius: '60px',
                  padding: '16px 40px',
                  fontWeight: 600,
                  fontSize: '16px',
                  height: 'auto',
                  marginTop: '8px',
                }}
              >
                <i className="fas fa-paper-plane" style={{ marginRight: '8px' }}></i>
                Отправить заявку
              </Button>
            </Form>
          </div>

        </div>
      </div>
    </div>
  );
};

export default RegisterPage;
