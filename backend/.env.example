# Скопируйте в backend/.env и заполните значения.
# Файл backend/.env не коммитьте.

# Публичный URL (ссылки в письмах подтверждения / сброса пароля)
PUBLIC_APP_URL=https://drc.ao-nk.ru

# Как у ps.ao-nk.ru (CT 213) и id.ao-nk.ru (CT 209): smtp.lite-host.in
# Ящик system@id.ao-nk.ru — общий служебный (пароль только в .env на сервере).
SMTP_HOST=smtp.lite-host.in
SMTP_PORT=465
SMTP_AUTH=1
SMTP_USER=system@id.ao-nk.ru
SMTP_PASSWORD=
SMTP_FROM=system@id.ao-nk.ru
SMTP_FROM_NAME=Цифровой реестр компетенций
# Альтернатива: внутренний postfix mail.ao-nk.site:25 с SMTP_AUTH=0

# ИИ-агент (ассистент Harmoni-BRICS, шаг 9.1)
# Техническое имя переменной — DEEPSEEK_API_KEY (провайдер API).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
