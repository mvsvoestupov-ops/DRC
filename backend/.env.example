# Скопируйте в backend/.env и заполните значения.
# Файл backend/.env не коммитьте.

# Публичный URL (ссылки в письмах подтверждения / сброса пароля)
PUBLIC_APP_URL=https://drc.ao-nk.ru

# Почта (Яндекс SMTP). Либо эти переменные, либо /opt/drc/PassForDRC_mail.txt
# (строка1: ящик, строка2: пароль приложения).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=ao-nkv@yandex.ru
SMTP_PASSWORD=
SMTP_FROM=ao-nkv@yandex.ru
SMTP_FROM_NAME=Цифровой реестр компетенций

# ИИ-агент (ассистент Harmoni-BRICS, шаг 9.1)
# Техническое имя переменной — DEEPSEEK_API_KEY (провайдер API).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
